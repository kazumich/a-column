{% extends "layout.html.twig" %}

{% block title %}タグ: {% for t in selected_tags %}{{ t.name }}{% if not loop.last %} + {% endif %}{% endfor %} — {{ site.name }}{% endblock %}

{% block content %}
  <div class="mb-6">

    {# 選択中タグ #}
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="text-sm text-gray-500 dark:text-gray-400">タグ:</span>
      {% for t in selected_tags %}
        <span class="inline-flex items-center gap-1 text-sm font-medium text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-700 px-2.5 py-1 rounded-full">
          {{ t.name }}
          <a href="{{ t.remove_url }}" class="text-blue-400 dark:text-blue-500 hover:text-blue-700 dark:hover:text-blue-300 leading-none" title="外す">✕</a>
        </span>
      {% endfor %}
    </div>

    {# 絞り込み候補 #}
    {% if related_tags %}
      <div class="flex flex-wrap items-center gap-2 p-3 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg">
        <span class="text-xs text-gray-400 dark:text-gray-500 shrink-0">さらに絞り込む:</span>
        {% for t in related_tags %}
          <a href="{{ t.url }}"
             class="text-xs text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 hover:border-blue-300 dark:hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 px-2 py-0.5 rounded-full transition-colors">
            {{ t.name }}
            <span class="text-gray-400 dark:text-gray-500">({{ t.count }})</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

  </div>

  {% include "modules/entry_summary.html.twig" %}
  {% include "modules/pagination.html.twig" %}
{% endblock %}
