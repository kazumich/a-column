<nav>
  <h2 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">カテゴリ</h2>
  <ul class="space-y-1">
    <li>
      <a href="/" class="block text-sm text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-700 px-2 py-1 rounded transition-colors">
        all
      </a>
    </li>
    {% for cat in categories %}
      <li>
        <a href="{{ cat.url }}"
           class="block text-sm text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-700 px-2 py-1 rounded transition-colors">
          {{ cat.label }}
        </a>
      </li>
    {% endfor %}
  </ul>
</nav>
