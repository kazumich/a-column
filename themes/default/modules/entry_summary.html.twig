{% if entries is empty %}
  <p class="text-gray-400 dark:text-gray-500 py-8 text-center">記事がありません。</p>
{% else %}
  <ul class="space-y-6">
    {% for entry in entries %}
      <li class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition-shadow">
        <a href="{{ entry.url }}" class="block group">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 py-0.5 rounded">
              {{ entry.category }}
            </span>
            <time class="text-xs text-gray-400 dark:text-gray-500" datetime="{{ entry.datetime }}">
              {{ entry.date }}
            </time>
            {% if entry.author %}
              <span class="text-xs text-gray-400 dark:text-gray-500">by {{ entry.author }}</span>
            {% endif %}
          </div>
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
            {{ entry.title }}
          </h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{{ entry.excerpt }}</p>
        </a>
        {% if entry.tags %}
          <div class="mt-3 flex flex-wrap gap-1">
            {% for tag in entry.tags %}
              <a href="/tag/{{ tag }}"
                 class="text-xs text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-700 hover:bg-blue-100 dark:hover:bg-blue-900 hover:text-blue-600 dark:hover:text-blue-400 px-2 py-0.5 rounded transition-colors">{{ tag }}</a>
            {% endfor %}
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
