<article>
  {% if is_admin %}
    <div class="mb-6 flex gap-1">
      <a href="/admin/entries/{{ entry.category }}/{{ entry.slug }}/edit"
         class="px-3 py-1 text-sm border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">編集</a>
      <form method="post" action="/admin/entries/{{ entry.category }}/{{ entry.slug }}/delete"
            onsubmit="return confirm('削除しますか？')">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button class="px-3 py-1 text-sm border border-red-300 text-red-600 rounded hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors">削除</button>
      </form>
      <form method="post" action="/admin/entries/{{ entry.category }}/{{ entry.slug }}/toggle-publish">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button class="px-3 py-1 text-sm border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
          {{ entry.published ? '非公開' : '公開する' }}
        </button>
      </form>
    </div>
  {% endif %}
  {% if entry.eyecatch %}
    <div class="w-full aspect-video rounded-lg mb-8 overflow-hidden">
      <img src="{{ entry.eyecatch }}" alt="{{ entry.title }}"
           class="w-full h-full object-cover">
    </div>
  {% endif %}
  <header class="mb-8">
    <div class="flex items-center gap-2 mb-3">
      <a href="/{{ entry.category }}"
         class="text-xs font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 py-0.5 rounded hover:bg-blue-100 dark:hover:bg-blue-900 transition-colors">
        {{ entry.category }}
      </a>
      <time class="text-sm text-gray-400 dark:text-gray-500" datetime="{{ entry.datetime }}">
        {{ entry.date }}
      </time>
      {% if entry.author %}
        <span class="text-sm text-gray-400 dark:text-gray-500">by {{ entry.author }}</span>
      {% endif %}
    </div>
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white leading-tight">{{ entry.title }}</h1>
    {% if entry.tags %}
      <div class="mt-3 flex flex-wrap gap-1">
        {% for tag in entry.tags %}
          <a href="/tag/{{ tag }}"
             class="text-xs text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-700 hover:bg-blue-100 dark:hover:bg-blue-900 hover:text-blue-600 dark:hover:text-blue-400 px-2 py-0.5 rounded transition-colors">{{ tag }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <div class="prose prose-gray dark:prose-invert max-w-none">
    {{ entry.body|raw }}
  </div>

  <footer class="mt-10 pt-6 border-t border-gray-200 dark:border-gray-700">
    <a href="/{{ entry.category }}"
       class="text-sm text-blue-600 dark:text-blue-400 hover:underline">
      ← {{ entry.category }} の記事一覧へ
    </a>
  </footer>
</article>
