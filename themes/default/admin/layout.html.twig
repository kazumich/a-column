<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}管理画面{% endblock %} — {{ site.name }}</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/assets/css/style.css">
  {% block head %}{% endblock %}
</head>
<body class="bg-gray-100 min-h-screen text-gray-800">

  <header class="bg-gray-900 text-white px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <span class="font-bold text-lg">{{ site.name }} <span class="text-gray-400 text-sm font-normal">管理画面</span></span>
      <nav class="flex gap-3 text-sm">
        <a href="/admin/entries" class="text-gray-300 hover:text-white transition-colors">記事一覧</a>
        <a href="/admin/entries/new" class="text-gray-300 hover:text-white transition-colors">新規作成</a>
        <a href="/admin/media" class="text-gray-300 hover:text-white transition-colors">メディア</a>
      </nav>
    </div>
    <div class="flex items-center gap-3 text-sm">
      <a href="/" target="_blank" class="text-gray-400 hover:text-white transition-colors">サイトを見る ↗</a>
      <a href="/admin/logout" class="text-gray-400 hover:text-white transition-colors">ログアウト</a>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-8">
    {% block content %}{% endblock %}
  </main>

  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
