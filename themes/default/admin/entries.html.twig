{% extends "admin/layout.html.twig" %}
{% block title %}記事一覧{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">記事一覧</h1>
  <a href="/admin/entries/new"
     class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded transition-colors">
    ＋ 新規作成
  </a>
</div>

<div class="bg-white rounded-xl shadow overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="text-left px-4 py-3 font-medium text-gray-600">タイトル</th>
        <th class="text-left px-4 py-3 font-medium text-gray-600 w-24">カテゴリ</th>
        <th class="text-left px-4 py-3 font-medium text-gray-600 w-28">日付</th>
        <th class="text-left px-4 py-3 font-medium text-gray-600 w-20">状態</th>
        <th class="px-4 py-3 w-48"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      {% for entry in entries %}
        <tr class="hover:bg-gray-50 transition-colors {% if not entry.published %}opacity-50{% endif %}">
          <td class="px-4 py-3">
            <a href="{{ entry.url }}" target="_blank"
               class="font-medium text-gray-800 hover:text-blue-600 transition-colors">
              {{ entry.title }}
            </a>
          </td>
          <td class="px-4 py-3 text-gray-500">{{ entry.category }}</td>
          <td class="px-4 py-3 text-gray-500">{{ entry.date }}</td>
          <td class="px-4 py-3">
            {% if entry.published %}
              <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full">公開</span>
            {% else %}
              <span class="text-xs bg-gray-200 text-gray-500 px-2 py-0.5 rounded-full">非公開</span>
            {% endif %}
          </td>
          <td class="px-4 py-3">
            <div class="flex gap-1 justify-end">
              <a href="/admin/entries/{{ entry.category }}/{{ entry.slug }}/edit"
                 class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-100 transition-colors">編集</a>
              <form method="post" action="/admin/entries/{{ entry.category }}/{{ entry.slug }}/duplicate">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-100 transition-colors">複製</button>
              </form>
              <form method="post" action="/admin/entries/{{ entry.category }}/{{ entry.slug }}/toggle-publish">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="px-2 py-1 text-xs border border-gray-300 rounded hover:bg-gray-100 transition-colors">
                  {{ entry.published ? '非公開に' : '公開する' }}
                </button>
              </form>
              <form method="post" action="/admin/entries/{{ entry.category }}/{{ entry.slug }}/delete"
                    onsubmit="return confirm('「{{ entry.title }}」を削除しますか？')">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button class="px-2 py-1 text-xs border border-red-300 text-red-600 rounded hover:bg-red-50 transition-colors">削除</button>
              </form>
            </div>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="5" class="px-4 py-8 text-center text-gray-400">記事がありません</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
